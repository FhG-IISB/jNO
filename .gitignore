# Auto-memory / agent scratch and other untracked outputs that the
# `!*.txt` re-include above would otherwise allow back in. Keep these
# AFTER the re-includes so they win.
-home-*/
mode_summary.txt
**/mode_summary.txt
tests/tutorial_results.txt
docs/tutorial_results.txt

# Whitepaper skill build artifacts (LaTeX intermediates, generated figures)
whitepapers/

# Benchmark outputs (results, figures) stay local. The runner scripts committed before this rule
# stay tracked -- gitignore never hides tracked files -- but ADDING a new script here needs
# `git add -f benchmarks/<name>.py`.
benchmarks/

# pixi environments
.pixi/*
!.pixi/config.toml
.coverage
coverage.xml
_tutorials_archive/

# gmsh scratch views written by size-field / background-mesh calls
*.pos
