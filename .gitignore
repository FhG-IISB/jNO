__pycache__/
*.py[cod]
*.egg-info
*.egg-info/
*.dot
*.lock
!pixi.lock
*.png
*.npz
*.msgpack
*.npy
*.pyc
*.txt

.jax_cache/
dist/
build/
site/
scripts/
misc/
